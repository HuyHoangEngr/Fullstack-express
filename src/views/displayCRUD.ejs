<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>get CRUD</title>
    <style>
      table,
      td,
      th {
        border: 1px solid black;
        text-align: center;
        border-collapse: collapse;
      }
      td {
        text-align: left;
      }

      .btn-edit {
        outline: none;
        border: none;
        background: orange;
        height: 25px;
        width: 60px;
        border-radius: 5px;
        cursor: pointer;
      }

      .btn-delete {
        outline: none;
        border: none;
        background: #ff2323;
        height: 25px;
        width: 60px;
        border-radius: 5px;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <table style="width: 100%">
      <tr>
        <th>Email</th>
        <th>Firstname</th>
        <th>Lastname</th>
        <th>Address</th>
        <th>Actions</th>
      </tr>
      <% for(let i=0; i < dataTable.length; i++) { %>
      <tr>
        <td><%= dataTable[i].email %></td>
        <td><%= dataTable[i].firstName %></td>
        <td><%= dataTable[i].lastName %></td>
        <td><%= dataTable[i].address %></td>
        <td style="text-align: center">
          <a
            href="/edit-crud?id=<%=dataTable[i].id%>"
            class="btn-edit"
            type="button"
            >Edit</a
          >
          <a
            href="/delete-crud?id=<%=dataTable[i].id%>"
            class="btn-delete"
            type="button"
            >Delete</a
          >
        </td>
      </tr>
      <% } %>
    </table>
  </body>
</html>
